# Streamlit web app image
FROM python:3.12-slim

WORKDIR /app
ENV MOEX_ROOT=/app \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY requirements-app.txt .
RUN pip install -r requirements-app.txt

# streamlit_app.py imports analysis_lib from scripts/ and reads aggregated data;
# reports/ provides the precomputed hourly table (raw 1.6 GB CSV is NOT shipped).
COPY app/ ./app/
COPY scripts/ ./scripts/
COPY data/processed/ ./data/processed/
COPY reports/ ./reports/
COPY .streamlit/ ./.streamlit/

EXPOSE 8501
CMD ["sh", "-c", "streamlit run app/streamlit_app.py --server.port=${PORT:-8501} --server.address=0.0.0.0"]
