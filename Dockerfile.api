# FastAPI service image
FROM python:3.12-slim

WORKDIR /app
ENV MOEX_ROOT=/app \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY requirements-app.txt .
RUN pip install -r requirements-app.txt

# api.py is self-contained; it only needs the aggregated data
COPY app/ ./app/
COPY data/processed/ ./data/processed/

EXPOSE 8000
# ${PORT} lets PaaS platforms (Render/Railway) inject the port; defaults to 8000.
CMD ["sh", "-c", "uvicorn api:app --app-dir app --host 0.0.0.0 --port ${PORT:-8000}"]
